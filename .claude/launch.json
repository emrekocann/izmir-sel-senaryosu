{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "afet-backend",
      "runtimeExecutable": "./venv/bin/uvicorn",
      "runtimeArgs": [
        "main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "vitrin",
      "runtimeExecutable": "./venv/bin/python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8010",
        "--directory",
        "docs",
        "--bind",
        "127.0.0.1"
      ],
      "port": 8010
    }
  ]
}
